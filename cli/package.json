{
  "name": "favium-cli",
  "version": "0.2.0",
  "description": "Favium CLI converts image files, including WebP, into PNG/ICO favicon bundles.",
  "bin": {
    "favium": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Toufiq Hasan Kiron",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiron0/favium",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/kiron0/favium/issues"
  },
  "homepage": "https://favium.js.org",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.9",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "cli": "node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "keywords": [
    "favicon",
    "ico",
    "png",
    "webp",
    "cli",
    "favicon-generator"
  ]
}
