{
  "name": "favium",
  "description": "Favium generates favicon assets from canvas in the browser and from image files in the terminal.",
  "version": "0.1.1",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "favium": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "author": "Toufiq Hasan Kiron",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiron0/favium"
  },
  "bugs": {
    "url": "https://github.com/kiron0/favium/issues"
  },
  "homepage": "https://favium.js.org",
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "cli": "node dist/cli.js",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "favicon",
    "ico",
    "png",
    "webp",
    "canvas",
    "browser",
    "cli",
    "favicons",
    "favicons-generator",
    "favicons-creator",
    "favicon-generator",
    "favicon-creator",
    "terminal"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "nanoid": "3.3.18",
    "picomatch": "4.0.7",
    "postcss": "8.5.26",
    "vite": "7.3.5"
  }
}
